# Flask
FLASK_APP=src
FLASK_ENV=development
SECRET_KEY=a_long_random_string_for_flask_sessions

# Database — SQLite for local dev, PostgreSQL URL for production
DATABASE_URL=sqlite:///taxidermatt.db

# Anthropic — used for PDF invoice extraction
ANTHROPIC_API_KEY=your_anthropic_key_here

# Railway — Account Token (not Project Token) required for billing scope
RAILWAY_API_KEY=your_railway_account_token_here

# RBA Exchange Rates — free tier at exchangeratesapi.com.au (300 calls/month)
RBA_API_KEY=your_rba_api_key_here

# Admin user — used by `flask create-admin` CLI command
ADMIN_EMAIL=mattacollis@gmail.com
ADMIN_PASSWORD=choose_a_strong_password
